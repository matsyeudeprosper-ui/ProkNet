<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 12+ (API 31+) Bluetooth permissions. neverForLocation tells the
         system we do not derive location from scans, so no location permission
         is needed on these versions. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Android 8-11 (API 26-30) legacy Bluetooth permissions. -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- FINE was only ever needed by the old radios: Android 8-11 BLE scan results, and
         the Android 8-12 local-only Wi-Fi hotspot. Android 13+ uses NEARBY_WIFI_DEVICES
         and BLUETOOTH_SCAN/neverForLocation instead, so FINE stays capped - ProkNet does
         not want, and must never ask for, an exact position on a modern phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- v0.17.6 ROOT CAUSE FIX. COARSE used to carry the same cap, for the same old-radio
         reason. But v0.13 made the coarse ZONE the thing the entire Network Brain runs on
         - no zone, no presence, no demand, no coverage - and nobody lifted the cap. So on
         Android 13, 14 and 15 this permission was NOT DECLARED AT ALL: checkSelfPermission
         could only ever return DENIED and requestPermissions could only ever do nothing.
         The pilot OUKITEL is Android 15, which is why it was invisible to the Brain for a
         whole day and why no amount of granting in settings would have helped. A 500 m
         cell is all ProkNet ever needs, and now it is all it asks for. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />

    <!-- v0.5 Wi-Fi transport: local-only hotspot, joining it, TCP sockets. No Internet is used. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Milestone 2B: foreground service with a persistent notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- v0.17.6: the foreground service keeps the coarse zone alive while the app is
         closed. This is what makes an IDLE provider discoverable, which is the whole
         point of v0.17.3. Deliberately NOT ACCESS_BACKGROUND_LOCATION: a foreground
         service declaring the location type may receive updates on the ordinary coarse
         permission, so nobody is ever sent into system settings for it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        v0.16.0: the stronger of the two payment-receipt sources. Optional by design.
        ProkNet never becomes the default SMS app and never reads the inbox; this is
        used only to see an incoming operator message while a payment is expected.
        Where distribution rules forbid it, the notification source is used instead.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />
    <!-- v0.9.7: Wi-Fi Direct is the experimental method B; a phone without it still runs everything else. -->
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <application
        android:name=".ProkNetApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/ProkTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v0.8: the engineering screen, reached from Profile > Developer / Diagnostics -->
        <activity
            android:name=".ui.P2pLabActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Prok Wi-Fi Direct Lab" />
        <activity
            android:name=".ui.BulkLabActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Prok Bluetooth Bulk Internet Lab" />
        <activity
            android:name=".ui.RelayLabActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Prok Relay Lab" />
        <activity
            android:name=".ui.LabActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:label="Prok Developer"
            android:windowSoftInputMode="adjustResize" />

        <!-- v0.6: buyer-side VPN. Only the system may bind it. -->
        <service
            android:name=".vpn.ProkVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".service.ProkNetService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|location"
            android:stopWithTask="false" />

        <!--
            v0.16.0: automatic Mobile Money receipt detection on the SELLER's phone.

            The seller grants notification access explicitly, in Android's own settings
            screen, and may revoke it there at any time. Only notifications posted by the
            phone's DEFAULT SMS application are ever looked at, and only while a payment
            is actually expected. Nothing reads the inbox and nothing scans history.
        -->
        <service
            android:name=".service.ReceiptListener"
            android:exported="false"
            android:label="@string/receipt_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            The stronger source, when the phone grants it. RECEIVE_SMS is restricted on
            Play, so ProkNet must work without it: this receiver simply never fires when
            the permission is absent, and the notification source carries the pilot.
        -->
        <receiver
            android:name=".service.SmsReceiptReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
