<?xml version="1.0" encoding="utf-8"?>
<!-- the one button: two soft glow rings around a lit sphere -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="@color/glow_soft" /></shape></item>
            <item android:inset="16dp"><shape android:shape="oval"><solid android:color="@color/glow" /></shape></item>
            <item android:inset="32dp"><shape android:shape="oval"><solid android:color="@color/brand_deep" /></shape></item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item><shape android:shape="oval"><solid android:color="@color/glow_soft" /></shape></item>
            <item android:inset="16dp"><shape android:shape="oval"><solid android:color="@color/glow" /></shape></item>
            <item android:inset="32dp">
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="150dp" android:centerX="0.38" android:centerY="0.32" android:startColor="#7FB0FF" android:centerColor="@color/brand" android:endColor="@color/brand_deep" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
