<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/brand_deep" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="@color/nav_inactive" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/brand" android:endColor="@color/brand_deep" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
