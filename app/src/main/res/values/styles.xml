<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProkTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="H1"><item name="android:textSize">26sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="H2"><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="Body"><item name="android:textSize">15sp</item><item name="android:textColor">@color/text</item></style>
    <style name="Muted"><item name="android:textSize">13sp</item><item name="android:textColor">@color/text_muted</item></style>
    <style name="Big"><item name="android:textSize">34sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="PrimaryButton"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">@color/on_brand</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">56dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="SecondaryButton"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/brand</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">56dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="DangerButton"><item name="android:background">@drawable/bg_danger</item><item name="android:textColor">@color/on_brand</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">56dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
</resources>
