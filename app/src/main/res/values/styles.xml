<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ProkTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- v0.19.1: every screen and every dialog wears the same system -->
        <item name="android:alertDialogTheme">@style/ProkDialog</item>
        <item name="android:editTextStyle">@style/Input</item>
        <item name="android:checkboxStyle">@style/Check</item>
        <item name="android:radioButtonStyle">@style/Radio</item>
    </style>

    <style name="ProkDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_muted</item>
        <item name="android:editTextStyle">@style/Input</item>
    </style>

    <!-- type -->
    <style name="H1"><item name="android:textSize">30sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="H2"><item name="android:textSize">19sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item><item name="android:letterSpacing">-0.01</item></style>
    <style name="H3"><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item></style>
    <style name="Body"><item name="android:textSize">15sp</item><item name="android:textColor">@color/text</item><item name="android:lineSpacingExtra">3dp</item></style>
    <style name="Muted"><item name="android:textSize">13sp</item><item name="android:textColor">@color/text_muted</item><item name="android:lineSpacingExtra">2dp</item></style>
    <style name="Caption"><item name="android:textSize">11sp</item><item name="android:textColor">@color/text_muted</item><item name="android:textAllCaps">true</item><item name="android:letterSpacing">0.1</item><item name="android:textStyle">bold</item></style>
    <style name="Big"><item name="android:textSize">36sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item><item name="android:letterSpacing">-0.02</item></style>
    <style name="Stat"><item name="android:textSize">22sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item><item name="android:letterSpacing">-0.01</item></style>
    <style name="ScreenTitle"><item name="android:textSize">24sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text</item><item name="android:letterSpacing">-0.02</item></style>

    <!-- buttons -->
    <style name="PrimaryButton"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">@color/on_brand</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">58dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item><item name="android:letterSpacing">0.01</item></style>
    <style name="SecondaryButton"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/text</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">56dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="DangerButton"><item name="android:background">@drawable/bg_danger</item><item name="android:textColor">@color/on_brand</item><item name="android:textSize">17sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">58dp</item><item name="android:layout_width">match_parent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <!-- v0.19.1: the compact pair for rows and toolbars, and the quiet text button -->
    <style name="SmallPrimary"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">@color/on_brand</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">46dp</item><item name="android:layout_width">wrap_content</item><item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item><item name="android:paddingStart">18dp</item><item name="android:paddingEnd">18dp</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="SmallSecondary"><item name="android:background">@drawable/bg_secondary</item><item name="android:textColor">@color/text</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">46dp</item><item name="android:layout_width">wrap_content</item><item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item><item name="android:paddingStart">18dp</item><item name="android:paddingEnd">18dp</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="GhostButton"><item name="android:background">?android:attr/selectableItemBackground</item><item name="android:textColor">@color/brand</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item><item name="android:layout_height">46dp</item><item name="android:layout_width">wrap_content</item><item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item><item name="android:paddingStart">12dp</item><item name="android:paddingEnd">12dp</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item></style>
    <style name="Segment"><item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">44dp</item><item name="android:gravity">center</item><item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/text_muted</item><item name="android:background">@android:color/transparent</item><item name="android:textAllCaps">false</item><item name="android:stateListAnimator">@null</item><item name="android:minWidth">0dp</item><item name="android:minHeight">0dp</item></style>

    <!-- inputs and choices -->
    <style name="Input" parent="android:Widget.Material.Light.EditText"><item name="android:background">@drawable/bg_input</item><item name="android:paddingStart">16dp</item><item name="android:paddingEnd">16dp</item><item name="android:paddingTop">14dp</item><item name="android:paddingBottom">14dp</item><item name="android:textSize">15sp</item><item name="android:textColor">@color/text</item><item name="android:textColorHint">@color/text_muted</item><item name="android:minHeight">52dp</item></style>
    <style name="Check" parent="android:Widget.Material.Light.CompoundButton.CheckBox"><item name="android:textSize">14sp</item><item name="android:textColor">@color/text</item><item name="android:paddingStart">8dp</item><item name="android:lineSpacingExtra">2dp</item></style>
    <style name="Radio" parent="android:Widget.Material.Light.CompoundButton.RadioButton"><item name="android:textSize">15sp</item><item name="android:textColor">@color/text</item><item name="android:paddingStart">8dp</item><item name="android:paddingTop">8dp</item><item name="android:paddingBottom">8dp</item></style>
</resources>
