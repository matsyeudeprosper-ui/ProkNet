<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- the honest first line: N retraits en attente = N envois manuels -->
        <TextView android:id="@+id/trSentence" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="18sp" android:textStyle="bold" android:text="…" />
        <TextView android:id="@+id/trNote" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:textSize="13sp"
            android:text="Le registre ne peut pas envoyer d'argent. Chaque retrait ci-dessous est un envoi Mobile Money à faire à la main, puis à marquer ici." />
        <TextView android:id="@+id/trSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textSize="13sp" android:text="" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/btnTrRefresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rafraîchir" />
            <Button android:id="@+id/btnTrBalance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Solde du jour" />
            <Button android:id="@+id/btnTrTestCredit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Crédit test" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textStyle="bold" android:text="Retraits" />
        <LinearLayout android:id="@+id/trRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/trEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:text="Aucun retrait en attente." />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:textStyle="bold" android:text="Messages à vérifier" />
        <LinearLayout android:id="@+id/trReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/trReviewEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:text="Rien à vérifier." />

        <TextView android:id="@+id/trFooter" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textSize="12sp" android:text="" />
    </LinearLayout>
</ScrollView>
