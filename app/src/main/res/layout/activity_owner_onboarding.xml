<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <include layout="@layout/view_header" />

        <TextView android:id="@+id/ooFlag" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_alt" android:padding="16dp" android:text="" style="@style/Muted" android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1 · Le réseau que je contrôle" style="@style/H2" />
            <TextView android:id="@+id/ooChecks" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" style="@style/Muted" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2 · Les conditions de mon fournisseur" style="@style/H2" />
            <CheckBox android:id="@+id/ooAttest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3 · Mon choix" style="@style/H2" />
            <RadioGroup android:id="@+id/ooChoice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                <RadioButton android:id="@+id/ooFree" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
                <RadioButton android:id="@+id/ooEarn" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
                <RadioButton android:id="@+id/ooSponsored" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
            </RadioGroup>
            <Button android:id="@+id/btnOoQuote" android:text="Voir l'offre de ProkNet" style="@style/PrimaryButton" android:layout_marginTop="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_accent" android:padding="22dp" android:layout_marginBottom="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4 · L'offre" style="@style/H2" />
            <TextView android:id="@+id/ooQuote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Aucune offre demandée. Vous ne tapez jamais de tarif : ProkNet fixe le prix client et votre part, vous acceptez ou refusez." style="@style/Body" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
                <Button android:id="@+id/btnOoAccept" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:text="Accepter" style="@style/SmallPrimary" android:enabled="false" />
                <Button android:id="@+id/btnOoDecline" android:layout_width="0dp" android:layout_weight="1" android:layout_height="52dp" android:layout_marginStart="8dp" android:text="Refuser" style="@style/SmallSecondary" android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <TextView android:id="@+id/ooFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/Muted" android:gravity="center" />
    </LinearLayout>
</ScrollView>
