<?xml version="1.0" encoding="utf-8"?>
<!-- v0.12 consumer screen, French: one big action on the home tab, then Internet, Carte, Gagner, Activité.
     Every visible word comes from res/values/strings.xml or from core/ProductState. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ================= HOME: one big button ================= -->
        <ScrollView android:id="@+id/tabHome" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:gravity="center_horizontal">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_primary" android:gravity="center" android:text="@string/brand_initial" android:textColor="@color/on_brand" android:textSize="24sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/brand_full" style="@style/H1" />
                    <TextView android:id="@+id/chipNode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="@string/node_off" style="@style/Muted" />
                </LinearLayout>

                <!-- the question, the button, the promise -->
                <LinearLayout android:id="@+id/homeAsk" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/home_question" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/text" android:layout_marginTop="8dp" android:layout_marginBottom="24dp" />
                    <Button android:id="@+id/btnGetInternet" android:layout_width="220dp" android:layout_height="220dp" android:background="@drawable/bg_big_button"
                        android:text="@string/get_internet_big" android:textColor="@color/on_brand" android:textSize="22sp" android:textStyle="bold" android:textAllCaps="false" android:stateListAnimator="@null" android:elevation="6dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:text="@string/home_promise" android:textSize="16sp" android:textColor="@color/text_muted" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" />
                </LinearLayout>

                <!-- the status card while searching / connecting / connected / failed -->
                <LinearLayout android:id="@+id/homeStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="20dp" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:visibility="gone">
                    <TextView android:id="@+id/homeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text" />
                    <TextView android:id="@+id/homeSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" android:textSize="15sp" android:textColor="@color/text_muted" />
                    <ProgressBar android:id="@+id/homeProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" />
                    <TextView android:id="@+id/homeMoney" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="" android:visibility="gone" android:textSize="17sp" android:textColor="@color/text" android:lineSpacingExtra="6dp" />
                    <Button android:id="@+id/btnHomeStop" android:text="@string/stop_big" style="@style/DangerButton" android:layout_marginTop="18dp" />
                </LinearLayout>

                <!-- what ProkNet knows around here -->
                <LinearLayout android:id="@+id/homeCoverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_alt" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/homeCoverageTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_around" style="@style/H2" />
                    <TextView android:id="@+id/homeCoverageSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Body" />
                </LinearLayout>

                <Button android:id="@+id/btnShareInternet" android:text="@string/share_internet" style="@style/SecondaryButton" />
                <TextView android:id="@+id/homeNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:gravity="center" android:text="" style="@style/Muted" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= INTERNET: choose by hand ================= -->
        <ScrollView android:id="@+id/tabInternet" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/internet_nearby" style="@style/H1" android:layout_marginBottom="12dp" />

                <LinearLayout android:id="@+id/netOffers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/netOffersHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offers_title" style="@style/Muted" android:layout_marginBottom="8dp" />
                    <LinearLayout android:id="@+id/netOfferList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <TextView android:id="@+id/netNoOffers" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="18dp" android:text="@string/offers_none" style="@style/Body" />
                </LinearLayout>

                <LinearLayout android:id="@+id/netConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/confirmTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/offer_available" style="@style/H2" />
                        <TextView android:id="@+id/confirmPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/confirm_price" style="@style/Big" />
                        <TextView android:id="@+id/confirmMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/confirm_minimum" style="@style/Body" />
                        <TextView android:id="@+id/confirmLimit" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/confirm_limit_unlimited" style="@style/Body" />
                        <TextView android:id="@+id/confirmSignal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/confirm_signal" style="@style/Muted" />
                        <TextView android:id="@+id/confirmFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" style="@style/Muted" />
                    </LinearLayout>
                    <Button android:id="@+id/btnConnect" android:text="@string/connect_big" style="@style/PrimaryButton" android:layout_marginBottom="10dp" />
                    <Button android:id="@+id/btnConfirmBack" android:text="@string/back" style="@style/SecondaryButton" />
                </LinearLayout>

                <LinearLayout android:id="@+id/netActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/activeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/state_finding" style="@style/H2" />
                        <TextView android:id="@+id/activeHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Muted" />
                        <ProgressBar android:id="@+id/activeProgress" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="?android:attr/progressBarStyleHorizontal" android:indeterminate="true" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/activeStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp" android:visibility="gone">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginEnd="6dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_used" style="@style/Muted" />
                            <TextView android:id="@+id/activeData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 o" style="@style/H2" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginStart="6dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cost_so_far" style="@style/Muted" />
                            <TextView android:id="@+id/activeCost" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/H2" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/activeDetail" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/Muted" android:layout_marginBottom="12dp" />
                    <Button android:id="@+id/btnStopInternet" android:text="@string/disconnect" style="@style/DangerButton" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= MAP: where ProkNet has seen Internet ================= -->
        <ScrollView android:id="@+id/tabMap" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_map" style="@style/H1" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_question" style="@style/Muted" android:layout_marginBottom="12dp" />
                <net.prok.proknet.ui.CoverageMapView android:id="@+id/mapView" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/map_legend_green" android:textSize="12sp" android:textColor="@color/text" android:background="#7ED6A2" android:padding="8dp" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/map_legend_yellow" android:textSize="12sp" android:textColor="@color/text" android:background="#F2D27A" android:padding="8dp" android:layout_marginEnd="4dp" />
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/map_legend_red" android:textSize="12sp" android:textColor="@color/text" android:background="#E1E5EC" android:padding="8dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_alt" android:padding="16dp" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/mapHereTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/H2" />
                    <TextView android:id="@+id/mapHereSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Body" />
                </LinearLayout>
                <Button android:id="@+id/btnMapLocation" android:text="@string/map_allow_location" style="@style/SecondaryButton" android:layout_marginBottom="12dp" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/map_known" style="@style/Muted" android:layout_marginBottom="8dp" />
                <LinearLayout android:id="@+id/mapList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/mapEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="18dp" android:text="@string/map_empty" style="@style/Body" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= EARN: share my Internet ================= -->
        <ScrollView android:id="@+id/tabEarn" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/earn_title" style="@style/H1" android:layout_marginBottom="12dp" />

                <!-- setup -->
                <LinearLayout android:id="@+id/netShareSetup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/shareUpstream" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/H2" />
                        <TextView android:id="@+id/shareWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Muted" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/share_price_big" style="@style/Muted" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                            <EditText android:id="@+id/sharePrice" android:layout_width="90dp" android:layout_height="wrap_content" android:inputType="number" android:text="5" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/text" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/per_mb" android:textSize="20sp" android:textColor="@color/text" android:layout_marginStart="8dp" />
                        </LinearLayout>
                        <TextView android:id="@+id/shareFee" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" style="@style/Muted" />
                        <TextView android:id="@+id/btnShareOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/share_options" android:textColor="@color/brand" android:textSize="14sp" android:padding="6dp" />
                        <LinearLayout android:id="@+id/shareOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/share_min_label" style="@style/Muted" />
                            <EditText android:id="@+id/shareMin" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="0" style="@style/Body" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/share_max_label" style="@style/Muted" />
                            <EditText android:id="@+id/shareMax" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:text="0" style="@style/Body" />
                        </LinearLayout>
                    </LinearLayout>
                    <Button android:id="@+id/btnStartSharing" android:text="@string/start_sharing_big" style="@style/PrimaryButton" android:layout_marginBottom="12dp" />
                </LinearLayout>

                <!-- active -->
                <LinearLayout android:id="@+id/netShareActive" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                        <TextView android:id="@+id/shareTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_sharing" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text" />
                        <TextView android:id="@+id/shareHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Muted" />
                        <TextView android:id="@+id/shareTerms" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="" style="@style/Body" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginEnd="4dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clients" style="@style/Muted" />
                            <TextView android:id="@+id/shareClients" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" style="@style/H2" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/shared_today" style="@style/Muted" />
                            <TextView android:id="@+id/shareData" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 o" style="@style/H2" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginStart="4dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/earned_today" style="@style/Muted" />
                            <TextView android:id="@+id/shareEarned" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/H2" />
                        </LinearLayout>
                    </LinearLayout>
                    <TextView android:id="@+id/shareCustomer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_alt" android:padding="14dp" android:text="" style="@style/Body" android:layout_marginBottom="12dp" />
                    <Button android:id="@+id/btnStopSharing" android:text="@string/stop_sharing" style="@style/DangerButton" android:layout_marginBottom="12dp" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/total_earned" style="@style/Muted" />
                    <TextView android:id="@+id/earnTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/Big" />
                    <TextView android:id="@+id/earnSub" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Muted" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_title" style="@style/H2" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/help_text" style="@style/Body" />
                    <TextView android:id="@+id/earnRelayStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" style="@style/Muted" />
                    <Switch android:id="@+id/switchRelay" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/help_switch" style="@style/Body" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- ================= ACTIVITY (+ account) ================= -->
        <ScrollView android:id="@+id/tabActivity" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_activity" style="@style/H1" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginEnd="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallet_to_pay" style="@style/Muted" />
                        <TextView android:id="@+id/walletPay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/H2" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginStart="4dp" android:layout_marginEnd="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallet_to_receive" style="@style/Muted" />
                        <TextView android:id="@+id/walletReceive" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/H2" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="12dp" android:layout_marginStart="4dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallet_fees" style="@style/Muted" />
                        <TextView android:id="@+id/walletFees" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0 CFA" style="@style/H2" />
                    </LinearLayout>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wallet_note" style="@style/Muted" android:layout_marginBottom="12dp" />
                <LinearLayout android:id="@+id/activityList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/activityEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:padding="18dp" android:text="@string/activity_none" style="@style/Body" android:layout_marginBottom="20dp" />

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/tab_profile" style="@style/H1" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:id="@+id/profileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/H2" />
                    <TextView android:id="@+id/profileId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" style="@style/Muted" />
                    <Button android:id="@+id/btnRename" android:text="@string/change_name" style="@style/SecondaryButton" android:layout_marginTop="12dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/prok_network" style="@style/H2" />
                    <TextView android:id="@+id/profileService" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="" style="@style/Body" />
                    <Switch android:id="@+id/switchNode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/keep_running" style="@style/Body" />
                    <Button android:id="@+id/btnBattery" android:text="@string/allow_background" style="@style/SecondaryButton" android:layout_marginTop="12dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card" android:padding="18dp" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/developer_title" style="@style/H2" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/developer_text" style="@style/Muted" />
                    <Button android:id="@+id/btnDeveloper" android:text="@string/developer_open" style="@style/SecondaryButton" android:layout_marginTop="12dp" />
                </LinearLayout>
                <TextView android:id="@+id/profileVersion" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" style="@style/Muted" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- bottom navigation -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal" android:background="@color/nav_bg">
        <LinearLayout android:id="@+id/navHome" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
            <ImageView android:id="@+id/navHomeIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:contentDescription="@string/tab_home" />
            <TextView android:id="@+id/navHomeText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_home" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navInternet" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
            <ImageView android:id="@+id/navInternetIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_globe" android:contentDescription="@string/tab_internet" />
            <TextView android:id="@+id/navInternetText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_internet" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navMap" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
            <ImageView android:id="@+id/navMapIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_map" android:contentDescription="@string/tab_map" />
            <TextView android:id="@+id/navMapText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_map" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navEarn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
            <ImageView android:id="@+id/navEarnIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_coins" android:contentDescription="@string/tab_earn" />
            <TextView android:id="@+id/navEarnText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_earn" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/navActivity" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true" android:background="?android:attr/selectableItemBackground">
            <ImageView android:id="@+id/navActivityIcon" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_list" android:contentDescription="@string/tab_activity" />
            <TextView android:id="@+id/navActivityText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tab_activity" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
