<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">

        <include layout="@layout/view_header" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_alt" android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/mmSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" style="@style/Body" />
            <Button android:id="@+id/btnMmRefresh" android:text="Actualiser" style="@style/GhostButton" android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:text="Annonces à relire" style="@style/Caption" />
        <LinearLayout android:id="@+id/mmQueue" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:text="Signalements ouverts" style="@style/Caption" />
        <LinearLayout android:id="@+id/mmReports" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginBottom="10dp" android:text="Trésorerie · factures ouvertes" style="@style/Caption" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_card_alt" android:padding="16dp" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/mmTreasuryNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Visible seulement pour une identité trésorerie. Une facture n'est payée que sur une référence ET un montant exacts, avec un identifiant de transaction jamais utilisé. Rien n'est deviné." style="@style/Muted" />
            <Button android:id="@+id/btnMmMatch" android:text="Coller un message MoMo / Airtel" style="@style/SmallSecondary" android:layout_marginTop="12dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/mmInvoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />

        <TextView android:id="@+id/mmFooter" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Refuser une annonce ne laisse jamais le vendeur débité : la facture payée passe en remboursement, un crédit de forfait revient. Chaque décision est journalisée." style="@style/Muted" android:gravity="center" />
    </LinearLayout>
</ScrollView>
