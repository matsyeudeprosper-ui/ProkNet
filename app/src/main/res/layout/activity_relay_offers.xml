<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="18sp" android:textStyle="bold" android:text="Offres relais" />
        <TextView android:id="@+id/roFlag" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="13sp" android:text="" />
        <TextView android:id="@+id/roSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="13sp" android:text="" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
            <Button android:id="@+id/btnRoRefresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Rafraîchir" />
            <Button android:id="@+id/btnRoSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Mes réglages" />
            <Button android:id="@+id/btnRoStop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Arrêter" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textStyle="bold" android:text="Offres" />
        <LinearLayout android:id="@+id/roOffers" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/roEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:text="Aucune offre. Être en ligne ne rapporte rien : seule une offre acceptée et vérifiée paie." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textStyle="bold" android:text="Mes gains" />
        <TextView android:id="@+id/roPipeline" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:text="" />
        <TextView android:id="@+id/roCap" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:text="" />
    </LinearLayout>
</ScrollView>
