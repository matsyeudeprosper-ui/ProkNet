<?xml version="1.0" encoding="utf-8"?>
<!-- v0.10.2 Bluetooth test screen: one button per phone, everything else automatic. Details stay underneath for the developers. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView android:id="@+id/txtBulkRole" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="26sp" android:textStyle="bold" android:text="ProkNet Bluetooth" />
        <TextView android:id="@+id/txtBulkReady" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="16sp" android:layout_marginTop="8dp" android:text="" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnBulkSell" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="START SHARING" />
            <Button android:id="@+id/btnBulkBuy" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="CONNECT" />
        </LinearLayout>
        <Button android:id="@+id/btnBulkStop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="STOP" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginTop="12dp" android:text="Status:" />
        <TextView android:id="@+id/txtBulkHeadline" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="20sp" android:textStyle="bold" android:text="" />
        <TextView android:id="@+id/txtBulkLines" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="15sp" android:layout_marginTop="6dp" android:text="" />

        <Button android:id="@+id/btnBulkCopyResult" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="14dp" android:textStyle="bold" android:text="COPY TEST RESULT" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginTop="18dp"
            android:text="Details (for the developers, you do not need to read this):" />
        <TextView android:id="@+id/txtBulkState" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:fontFamily="monospace" android:layout_marginTop="4dp" android:text="" />
        <Button android:id="@+id/btnBulkDiag" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="COPY DIAGNOSTIC" />
    </LinearLayout>
</ScrollView>
